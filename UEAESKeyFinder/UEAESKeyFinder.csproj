<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>

    <!--
      net35  = .NET 3.5  → Exagear (Wine/Android), XP SP2+
      net40  = .NET 4.0  → Windows XP SP3 / Vista / 7 / 8 / 10 / 11
      net461 = .NET 4.6.1→ Windows 7 SP1+
      net48  = .NET 4.8  → Windows 7 SP1 / 8 / 8.1 / 10 / 11
      net481 = .NET 4.8.1→ Windows 10 / 11
    -->
    <TargetFrameworks>net35;net40;net461;net48;net481</TargetFrameworks>

    <Platforms>AnyCPU;x86;x64</Platforms>

    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>false</ImplicitUsings>

    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>

    <AssemblyName>UEAESKeyFinder</AssemblyName>
    <RootNamespace>UEAesKeyFinder</RootNamespace>
  </PropertyGroup>

  <!-- Costura.Fody только для net40+ — для net35 не поддерживается, Wine его ломает -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net35'">
    <PackageReference Include="Costura.Fody" Version="6.0.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Fody" Version="6.9.3">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
